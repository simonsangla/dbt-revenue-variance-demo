[sqlfluff]
dialect = duckdb
templater = dbt
# Baseline: layout (LT) + 6 style rules the existing models do not meet are deferred, not weakened silently.
exclude_rules = layout, AL01, ST05, ST06, ST09, RF04

[sqlfluff:templater:dbt]
profiles_dir = .

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 2
