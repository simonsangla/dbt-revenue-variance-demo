{
  "mcpServers": {
    "dbt": {
      "command": "uvx",
      "args": ["dbt-mcp@2.7.0"],
      "env": {
        "DBT_PROJECT_DIR": ".",
        "DBT_PROFILES_DIR": ".",
        "DBT_PATH": "dbt",
        "DISABLE_SEMANTIC_LAYER": "true",
        "DISABLE_DISCOVERY": "true",
        "DISABLE_ADMIN_API": "true",
        "DISABLE_REMOTE": "true",
        "DISABLE_SQL": "true",
        "DO_NOT_TRACK": "1"
      }
    }
  }
}
